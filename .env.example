# Database (Prisma + MySQL/MariaDB)
DATABASE_URL="mysql://root:@127.0.0.1:3306/brewpoints"

# App Configuration
NEXT_PUBLIC_APP_NAME="BrewPoints"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Loyalty Configuration
LOYALTY_POINTS_PER_UNIT=1
LOYALTY_MIN_SPEND=1.00
LOYALTY_MAX_SPEND=1000.00
LOYALTY_MAX_REWARD_COST=10000
LOYALTY_REDEMPTION_TTL=900
LOYALTY_ALLOCATION_TTL=600

# JWS Secret for QR tokens (Redemption & Allocation)
REDEMPTION_TOKEN_SECRET="change-me-in-production"

# Firebase (placeholder mode — set to true when using real Firebase)
FIREBASE_REAL="false"
FIREBASE_PROJECT_ID="brewpoints-placeholder"

# Placeholder Firebase UIDs for seeded dummy accounts
SEED_OWNER_FIREBASE_UID="owner-dummy-uid-001"
SEED_STAFF_FIREBASE_UID="staff-dummy-uid-001"
SEED_CUSTOMER_FIREBASE_UID="customer-dummy-uid-001"
